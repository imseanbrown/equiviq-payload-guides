    "./components": { "types": "./dist/types/components.d.ts", "import": "./dist/components.js" },
    "./filters": { "types": "./dist/types/filters.d.ts", "import": "./dist/filters.js" },
    "./view-tracker": { "types": "./dist/types/view-tracker.d.ts", "import": "./dist/view-tracker.js" },
    "./facet-field": { "types": "./dist/types/facet-field.d.ts", "import": "./dist/facet-field.js" },
